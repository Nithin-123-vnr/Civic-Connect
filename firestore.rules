rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStateAdmin() {
      return isAuthenticated() && getUserData().role == 'state_admin';
    }

    function isDistrictOfficer() {
      return isAuthenticated() && getUserData().role == 'district_officer';
    }

    function isMandalOfficer() {
      return isAuthenticated() && getUserData().role == 'mandal_officer';
    }

    function isOfficer() {
      return isStateAdmin() || isDistrictOfficer() || isMandalOfficer();
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        request.auth.uid == userId && request.resource.data.role == resource.data.role ||
        isStateAdmin()
      );
      allow delete: if isStateAdmin();
    }

    match /complaints/{complaintId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.status == 'pending';
      allow update: if isAuthenticated() && (
        isOfficer() ||
        (request.auth.uid == resource.data.citizenId && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['citizenRating', 'citizenFeedback', 'status', 'updatedAt', 'updates'])
        ))
      );
      allow delete: if isStateAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOfficer());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /complaint_updates/{updateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isStateAdmin();
    }
  }
}
