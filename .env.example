# CivicConnect Production Supabase Configuration
# Replace these values with your actual Supabase project settings:
# Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Geoapify Map API Configuration
# Get your API key from https://www.geoapify.com/
VITE_GEOAPIFY_API_KEY=your-geoapify-api-key-here
# Or alternatively (without VITE_ prefix):
# GEOAPIFY_API_KEY=your-geoapify-api-key-here
